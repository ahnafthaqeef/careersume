{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "careersume",
	// Built by `opennextjs-cloudflare build`, not checked in.
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-06-01",
	// `nodejs_compat` gives the worker node:crypto (BYOK AES-256-GCM key
	// derivation and encryption) plus the Buffer shim Next.js itself uses.
	// `global_fetch_strictly_public` keeps fetch() to our own hostname going out
	// over the public internet instead of looping back into this worker, which is
	// what /api/fetch-job-url and the provider adapters assume.
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},

	// The root of univa.my is served by the `univa-site` Cloudflare Pages
	// project; this route intercepts only /careersume* and leaves the rest of the
	// zone to Pages. A route rather than a custom domain for that reason: a
	// custom domain would claim the whole hostname. `basePath` in next.config.ts
	// is the matching half, so the app's own URLs stay inside this prefix.
	"routes": [
		{
			"pattern": "univa.my/careersume*",
			"zone_name": "univa.my"
		}
	]
}
